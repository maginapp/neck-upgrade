  "lunar_pengzu_heaven_0": {
    "message": "On Jia days, do not open the granary, or wealth will dissipate「甲不开仓财物耗散」"
  },
  "lunar_pengzu_heaven_1": {
    "message": "On Yi days, do not plant, or a thousand plants will fail to grow「乙不栽植千株不长」"
  },
  "lunar_pengzu_heaven_2": {
    "message": "On Bing days, do not repair the stove, or disaster will follow「丙不修灶必见灾殃」"
  },
  "lunar_pengzu_heaven_3": {
    "message": "On Ding days, do not shave the head, or sores will develop「丁不剃头头必生疮」"
  },
  "lunar_pengzu_heaven_4": {
    "message": "On Wu days, do not accept land, or the owner will face misfortune「戊不受田田主不祥」"
  },
  "lunar_pengzu_heaven_5": {
    "message": "On Ji days, do not void contracts, or both parties will suffer loss「己不破券二比并亡」"
  },
  "lunar_pengzu_heaven_6": {
    "message": "On Geng days, do not weave, or the loom will stand idle「庚不经络织机虚张」"
  },
  "lunar_pengzu_heaven_7": {
    "message": "On Xin days, do not make sauces, or the host will not taste them「辛不合酱主人不尝」"
  },
  "lunar_pengzu_heaven_8": {
    "message": "On Ren days, do not draw water, or danger will be hard to guard against「壬不泱水更难提防」"
  },
  "lunar_pengzu_heaven_9": {
    "message": "On Gui days, do not litigate, or your case will be weak and your opponent strong「癸不词讼理弱敌强」"
  },
  "lunar_pengzu_earth_0": {
    "message": "On Zi days, do not seek divination, or you may invite misfortune「子不问卜自惹祸殃」"
  },
  "lunar_pengzu_earth_1": {
    "message": "On Chou days, do not hold a coming-of-age ceremony, or the traveler may not return home「丑不冠带主不还乡」"
  },
  "lunar_pengzu_earth_2": {
    "message": "On Yin days, do not make ritual offerings, or the spirits will not receive them「寅不祭祀神鬼不尝」"
  },
  "lunar_pengzu_earth_3": {
    "message": "On Mao days, do not dig wells, or the water will turn foul「卯不穿井水泉不香」"
  },
  "lunar_pengzu_earth_4": {
    "message": "On Chen days, do not weep, or another bereavement may follow「辰不哭泣必主重丧」"
  },
  "lunar_pengzu_earth_5": {
    "message": "On Si days, do not travel far, or property may be lost「巳不远行财物伏藏」"
  },
  "lunar_pengzu_earth_6": {
    "message": "On Wu days, do not roof a house, or the owner may have to rebuild「午不苫盖屋主更张」"
  },
  "lunar_pengzu_earth_7": {
    "message": "On Wei days, do not take medicine, or toxins may enter the body「未不服药毒气入肠」"
  },
  "lunar_pengzu_earth_8": {
    "message": "On Shen days, do not install a bed, or evil spirits may enter the room「申不安床鬼祟入房」"
  },
  "lunar_pengzu_earth_9": {
    "message": "On You days, do not receive guests, or drunken disorder may follow「酉不会客醉坐颠狂」"
  },
  "lunar_pengzu_earth_10": {
    "message": "On Xu days, do not eat dog meat, or strange events may occur in bed「戌不吃犬作怪上床」"
  },
  "lunar_pengzu_earth_11": {
    "message": "On Hai days, do not marry, or it may harm the groom「亥不嫁娶不利新郎」"
  },
